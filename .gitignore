# Local .terraform directories
.terraform/
Terraform

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log

# Exclude override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Exclude CLI configuration files
.terraformrc
terraform.rc

# Lock file (optional, keep if you want reproducible provider versions)
.terraform.lock.hcl